# По умолчанию используется локально установленный и авторизованный Codex CLI.
LLM_PROVIDER=codex
CODEX_MODEL=
CODEX_TIMEOUT_MS=120000

# Необязательный альтернативный режим через OpenAI API (оплачивается отдельно).
# Для него укажите LLM_PROVIDER=openai и добавьте свой ключ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3000
MAX_DAILY_AI_REQUESTS=30
